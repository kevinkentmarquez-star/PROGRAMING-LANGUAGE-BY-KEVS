#include <iostream>
using namespace std;

int main() 
{
    int rows = 7;
    for (int i = 1; i <= rows; i++) {
        for (int j = 1; j <= rows - i; j++) {
            cout << " ";
        }
        for (int k = 1; k <= (2 * i - 1); k++) {
            cout << "*";
        }
        cout << endl;
    }
    return 0;
}
// full pyramid

#include <iostream>
using namespace std;

int main() {
    int rows = 6; 

    for (int i = rows; i >= 1; i--) {
        
        for (int j = 1; j <= i; j++) {
            cout << "* ";
        }
        
        cout << endl;
    }
    
    return 0;
}
// inverted pyramid 


#include <iostream>
using namespace std;

int main() {
    int rows = 8;
    
    for (int i = 1; i <= rows; i++) {
        
        for (int s = 1; s <= i - 1; s++) {
            cout << "   "; 
        }

        for (int j = 1; j <= rows - i + 1; j++) {
            cout << "  *";
        }
        cout << endl;
    }
    return 0;
}

